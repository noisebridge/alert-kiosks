#!/usr/bin/env python3
import json
import os
import socket
import time

KIOSK_URL = "{{ kiosk_url }}"

os.environ["MOZ_ENABLE_WAYLAND"] = "1"
os.environ["MOZ_CRASHREPORTER_DISABLE"] = "1"
os.environ["XKB_DEFAULT_LAYOUT"] = "us"


def _marionette_recv(sock):
    buf = b""
    while b":" not in buf:
        chunk = sock.recv(1)
        if not chunk:
            raise ConnectionError
        buf += chunk
    length = int(buf.split(b":")[0])
    body = buf.split(b":", 1)[1]
    while len(body) < length:
        body += sock.recv(length - len(body))
    return json.loads(body)


def _marionette_cmd(sock, msg_id, command, params=None):
    msg = json.dumps([0, msg_id, command, params or {}])
    sock.sendall(f"{len(msg)}:{msg}".encode())
    return _marionette_recv(sock)


def reload_watcher():
    while True:
        sock = None
        try:
            sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            sock.settimeout(15)
            sock.connect(("127.0.0.1", 2828))
            _marionette_recv(sock)
            _marionette_cmd(sock, 1, "WebDriver:NewSession")
            _marionette_cmd(sock, 2, "WebDriver:SetTimeouts", {"pageLoad": 15000})
            msg_id = 2

            while True:
                time.sleep(30)
                msg_id += 1
                resp = _marionette_cmd(sock, msg_id, "WebDriver:ExecuteScript", {"script": "return document.documentURI"})
                uri = resp[3]["value"] if resp[3] else ""
                if uri.startswith("about:"):
                    msg_id += 1
                    try:
                        _marionette_cmd(sock, msg_id, "WebDriver:Navigate", {"url": KIOSK_URL})
                    except Exception:
                        pass
        except Exception:
            time.sleep(5)
        finally:
            if sock:
                sock.close()


time.sleep(2)

if os.fork() == 0:
    reload_watcher()
    os._exit(0)

os.execvp("sway", ["sway"])
